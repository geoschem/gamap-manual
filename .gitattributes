# Let Git detect text files and normalize new ones to LF.  Files already
# committed with CRLF (doc/Chapter_*.html, doc/Contents.html, index.html,
# gamap.css) are left as-is by text=auto, so this causes no churn.
* text=auto

# Binary assets: never diff or convert
*.gif binary
*.jpg binary
*.png binary
*.pdf binary
*.db  binary

# Routine reference pages generated by IDL's mk_html_help.pro;
# collapse them in GitHub diffs
doc/all_routines/*.html linguist-generated
doc/by_alphabet/*.html  linguist-generated
doc/by_category/*.html  linguist-generated
